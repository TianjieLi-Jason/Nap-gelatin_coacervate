
;;;;;; Naphthyl isothiocyanate (SCN-out configuration)
;
; Note(s):
;   For minimizations, you may use define=-DFLEXIBLE to use a stiff-bond version of the topology that is more amenable to minimization.
;

[ moleculetype ]
; molname    nrexcl
  napo         1 

[ atoms ]
; nr type resnr residue atom cgnr charge mass
   1  N3d   1    NAPO    C1   1    0   
   2  TC5   1    NAPO    R2   2    0    45
   3  TC5   1    NAPO    R3   3    0    45
   4  TC5   1    NAPO    R4   4    0    45
   5  TC5   1    NAPO    R5   5    0    45
   6  TC5   1    NAPO    R6   6    0     0

[ bonds ]
; i  j  funct length
  1  2   1     0.322  100000 ; cog
  1  6   1     0.483  100000 ; cog
#ifndef FLEXIBLE
[constraints]
#endif
; i  j  funct length
  2  3   1     0.218 1000000 ; cog
  2  4   1     0.434 1000000 ; cog
  2  5   1     0.377 1000000 ; cog
  3  4   1     0.371 1000000 ; cog
  4  5   1     0.222 1000000 ; cog

[ angles ]
; i  j  k  funct   angle    force.c.

[ dihedrals ]
; improper
; i j k l  funct  ref.angle force_k
  1 3 4 5    2        0        50  ; controls planarity of ethyl group
  2 1 6 3    2        0        50  ; keeps ethyl on position 1 of naphthalene
  2 3 4 5    2        0       200  ; keeps naphthalene planar

[ virtual_sitesn ]
; site funct  constructing atom indices
   6     1     2 3 4 5

[ exclusions ]
 1 2 3 4 5 6
 2 3 4 5 6
 3 4 5 6
 4 5 6
 5 6
